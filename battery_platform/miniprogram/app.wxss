page{background:#f3f6fa;color:#142b42;font-family:system-ui,-apple-system,sans-serif;font-size:28rpx}.screen{padding:28rpx 28rpx 60rpx}.brand{font-size:44rpx;font-weight:650;margin:12rpx 0}.subtitle{color:#596b7e;font-size:26rpx;line-height:1.6;margin-bottom:24rpx}.card{background:#fff;border-radius:18rpx;padding:26rpx;margin-bottom:22rpx;border:1rpx solid #dfe7ef}.title{font-weight:650;font-size:32rpx;margin-bottom:16rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:14rpx 0}.badge{color:#156f64;background:#e7f5f1;padding:7rpx 14rpx;border-radius:8rpx;font-size:24rpx}.warning{color:#865920;background:#fff4df;border-radius:12rpx;padding:18rpx;line-height:1.6}.error{color:#a12b36}.muted{color:#65768a;font-size:25rpx;line-height:1.65}.label{display:block;color:#415469;margin:20rpx 0 10rpx;font-size:26rpx}input,textarea,.select{box-sizing:border-box;background:#f6f8fb;border:1rpx solid #dbe3eb;padding:18rpx;border-radius:10rpx;width:100%;font-size:28rpx;min-height:76rpx}textarea{height:190rpx}button{background:#126a60;color:#fff;border-radius:12rpx;font-size:28rpx;margin-top:20rpx}button.secondary{background:#e8eef5;color:#24415d}button.danger{background:#ffe9e8;color:#922b32}button[disabled]{background:#dce4ec;color:#789}pre,.json{font-family:monospace;white-space:pre-wrap;word-break:break-all;font-size:24rpx;line-height:1.6}.divider{height:1rpx;background:#e4eaf1;margin:24rpx 0}.empty{text-align:center;padding:50rpx;color:#687b8e}.photo{width:160rpx;height:160rpx;border-radius:12rpx;margin:10rpx}.link{color:#16786e}.actions{display:flex;gap:16rpx}.actions button{flex:1}.value{font-weight:600}.check{font-size:26rpx;line-height:1.6}.status{font-weight:600;color:#0e7468}
